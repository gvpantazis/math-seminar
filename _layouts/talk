---
layout: default
---

<article class="talk-page">
  <h1>{{ page.title }}</h1>

  <div class="talk-card">
    <p><strong>Speaker:</strong> {{ page.speaker }}</p>
    <p><strong>Date:</strong> {{ page.date | date: "%A, %B %-d, %Y" }}</p>
    <p><strong>Time:</strong> {{ page.time }}</p>
    <p><strong>Location:</strong> {{ page.location }}</p>
  </div>

  <h2>Abstract</h2>

  {{ content }}
</article>
